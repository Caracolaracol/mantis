---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import { href, site, localizedHref, type Language } from '../lib/site';
const { language = 'en' } = Astro.props as { language?: Language };
const t = (en: string, es: string) => language === 'es' ? es : en;
const screenshot = href(language === 'es' ? 'images/library-es.png' : 'images/library.png');
---
<SiteLayout language={language} title={t('Mantis — What you hear, Mantis records', 'Mantis — Lo que escuchas, Mantis lo graba')} description={t('Record your computer, microphone, or an app. Optional local transcription, M4A files, and open source. For macOS and Apple Silicon.', 'Graba audio del computador, micrófono o una aplicación. Transcripción local opcional, archivos M4A y código abierto. Para macOS y Apple Silicon.')}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{t('What you hear,', 'Lo que escuchas,')}<br /><em>{t('Mantis records.', 'Mantis lo graba.')}</em></h1>
      <p class="hero-description">{t('Record a conversation, a class, or an idea. Save the audio on your Mac and, if you want, turn it into text. No account needed.', 'Graba una conversación, una clase o una idea. Guarda el audio en tu Mac y, si quieres, conviértelo en texto. Sin cuentas.')}</p>
      <div class="hero-actions"><a class="button primary" href={site.download}><Icon name="download" />{t('Download for Mac', 'Descargar para Mac')}<span class="button-arrow" aria-hidden="true">↗</span></a><a class="text-link" href={localizedHref(language, 'docs')}>{t('Meet Mantis', 'Conoce Mantis')} <span aria-hidden="true">→</span></a></div>
      <p class="download-meta">v{site.version} · macOS 15+ · Apple Silicon <span>{t('Free and open source', 'Gratis y de código abierto')}</span></p>
      <button class="home-motion-toggle" id="grain-toggle" type="button" aria-pressed="false" hidden>{t('Pause motion', 'Pausar movimiento')}</button>
      <div class="hero-footnote"><span class="tiny-mark" aria-hidden="true">✳</span><p>{t('No rush to transcribe.', 'Sin prisa por transcribir.')}<br />{t('The audio is yours from the start.', 'El audio es tuyo desde el primer momento.')}</p></div>
    </div>
    <figure class="hero-screen">
      <div class="screen-halo" aria-hidden="true"></div>
      <div class="window-label"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{t('YOUR LIBRARY, NOTHING IN THE WAY', 'TU BIBLIOTECA, SIN VUELTAS')}</span><span aria-hidden="true">↗</span></div>
      <a class="screen-link" href={screenshot} aria-label={t('View the full Mantis library screenshot', 'Ver captura completa de la biblioteca de Mantis')}><img src={screenshot} width="780" height="1000" alt={t('Mantis library with recordings, search, the record button, and a sample transcript', 'Biblioteca de Mantis con grabaciones, búsqueda, botón de grabación y una transcripción de ejemplo')} fetchpriority="high" /></a>
    </figure>
  </section>
  <div class="manifesto-strip"><div class="wrap"><span>{t('AUDIO ONLY', 'SOLO AUDIO')}</span><span aria-hidden="true">✳</span><span>{t('LOCAL FIRST', 'PRIMERO LOCAL')}</span><span aria-hidden="true">✳</span><span>{t('NO ACCOUNTS', 'SIN CUENTAS')}</span><span aria-hidden="true">✳</span><span>{t('MIT / OPEN SOURCE', 'MIT / CÓDIGO ABIERTO')}</span></div></div>
</SiteLayout>
