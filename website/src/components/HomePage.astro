---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import { href, site, localizedHref, type Language } from '../lib/site';
const { language = 'en' } = Astro.props as { language?: Language };
const t = (en: string, es: string) => language === 'es' ? es : en;
const screenshot = href(language === 'es' ? 'images/library-es.png' : 'images/library.png');
const features = [
  { icon: 'audio' as const, title: t('Choose what you hear.', 'Escoge lo que escuchas.'), text: t('Your computer, your microphone, or one app. Together or separately. Audio only, never video files.', 'El computador, tu micrófono o una aplicación. Juntos o por separado. Solo audio, nunca archivos de video.') },
  { icon: 'folder' as const, title: t('Your library. Your files.', 'Una biblioteca. Tus archivos.'), text: t('M4A files named by date and time. Search, listen, open in Finder, or drag your audio wherever you need it.', 'M4A con nombres de fecha y hora. Busca, escucha, abre en Finder o arrastra el audio a donde lo necesites.') },
  { icon: 'local' as const, title: t('The words, if you want them.', 'El texto, si tú quieres.'), text: t('Transcribe on your Mac with local models. Or don’t: keeping just the audio is fine too. You choose when and how.', 'Transcribe en tu Mac con modelos locales. O no: guardar solo el audio también está bien. Tú eliges cuándo y cómo.') },
];
---
<SiteLayout language={language} title={t('Mantis — What you hear, Mantis records', 'Mantis — Lo que escuchas, Mantis lo graba')} description={t('Record your computer, microphone, or an app. Optional local transcription, M4A files, and open source. For macOS and Apple Silicon.', 'Graba audio del computador, micrófono o una aplicación. Transcripción local opcional, archivos M4A y código abierto. Para macOS y Apple Silicon.')}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{t('What you hear,', 'Lo que escuchas,')}<br /><em>{t('Mantis records.', 'Mantis lo graba.')}</em></h1>
      <p class="hero-description">{t('Record a conversation, a class, or an idea. Save the audio on your Mac and, if you want, turn it into text. No account needed.', 'Graba una conversación, una clase o una idea. Guarda el audio en tu Mac y, si quieres, conviértelo en texto. Sin cuentas.')}</p>
      <div class="hero-actions"><a class="button primary" href={site.download}><Icon name="download" />{t('Download for Mac', 'Descargar para Mac')}<span class="button-arrow" aria-hidden="true">↗</span></a><a class="text-link" href={localizedHref(language, 'docs')}>{t('Meet Mantis', 'Conoce Mantis')} <span aria-hidden="true">→</span></a></div>
      <p class="download-meta">v{site.version} · macOS 15+ · Apple Silicon <span>{t('Free and open source', 'Gratis y de código abierto')}</span></p>
      <div class="hero-footnote"><span class="tiny-mark" aria-hidden="true">✳</span><p>{t('No rush to transcribe.', 'Sin prisa por transcribir.')}<br />{t('The audio is yours from the start.', 'El audio es tuyo desde el primer momento.')}</p></div>
    </div>
    <figure class="hero-screen">
      <div class="screen-halo" aria-hidden="true"></div>
      <div class="window-label"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{t('YOUR LIBRARY, NOTHING IN THE WAY', 'TU BIBLIOTECA, SIN VUELTAS')}</span><span aria-hidden="true">↗</span></div>
      <a class="screen-link" href={screenshot} aria-label={t('View the full Mantis library screenshot', 'Ver captura completa de la biblioteca de Mantis')}><img src={screenshot} width="780" height="1000" alt={t('Mantis library with recordings, search, the record button, and a sample transcript', 'Biblioteca de Mantis con grabaciones, búsqueda, botón de grabación y una transcripción de ejemplo')} fetchpriority="high" /></a>
    </figure>
  </section>
  <div class="manifesto-strip"><div class="wrap"><span>{t('AUDIO ONLY', 'SOLO AUDIO')}</span><span aria-hidden="true">✳</span><span>{t('LOCAL FIRST', 'PRIMERO LOCAL')}</span><span aria-hidden="true">✳</span><span>{t('NO ACCOUNTS', 'SIN CUENTAS')}</span><span aria-hidden="true">✳</span><span>{t('MIT / OPEN SOURCE', 'MIT / CÓDIGO ABIERTO')}</span></div></div>
  <section class="features wrap" aria-labelledby="features-title">
    <div class="section-heading"><p class="eyebrow">{t('FEWER MIDDLEMEN. MORE YOURS.', 'MENOS INTERMEDIARIOS, MÁS TUYO')}</p><h2 id="features-title">{t('Recording should', 'Grabar debería')}<br /><em>{t('be this simple.', 'ser así de simple.')}</em></h2><p>{t('Mantis is not another place to upload your things.', 'Mantis no es otro lugar al que subir tus cosas.')}<br />{t('It’s a tool for keeping them.', 'Es una herramienta para quedártelas.')}</p></div>
    <div class="feature-grid">{features.map((feature, index) => <article class="feature"><div class="feature-top"><Icon name={feature.icon} /><span>0{index + 1}</span></div><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
  </section>
  <section class="local-section wrap" aria-labelledby="local-title">
    <div class="local-graphic" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-label orbit-label-one">AUDIO</div><div class="orbit-label orbit-label-two">{t('TEXT', 'TEXTO')}</div><div class="local-core"><img src={href('images/mantis-mark.svg')} width="88" height="88" alt="" /><span>{t('ON YOUR MAC', 'EN TU MAC')}</span></div><div class="local-coordinate">MANTIS / LOCAL FIRST</div></div>
    <div class="local-copy"><p class="eyebrow">{t('HERE, NOT ON ANOTHER SERVER', 'AQUÍ, NO EN OTRO SERVIDOR')}</p><h2 id="local-title">{t('Your voice doesn’t', 'Tu voz no necesita')}<br /><em>{t('need a round trip.', 'hacer un viaje.')}</em></h2><p>{t('Transcription runs on your computer with', 'La transcripción funciona en tu equipo con')} <a href="https://github.com/handy-computer/transcribe.cpp">transcribe.cpp</a>. {t('Download a compatible model when you decide to; you don’t need one to record.', 'Descarga un modelo compatible cuando lo decidas; no hace falta ninguno para grabar.')}</p><p class="honest-note">{t('One important note: a synced folder may upload files to its provider. And if you drag audio into an external service, that service may receive it. You decide where it goes.', 'Una nota importante: una carpeta sincronizada puede subir archivos a su proveedor. Y si arrastras un audio a un servicio externo, ese servicio puede recibirlo. Tú decides el destino.')}</p><a class="text-link" href={`${localizedHref(language, 'docs')}#privacidad`}>{t('How your data is handled', 'Cómo cuidamos tus datos')} <Icon name="arrow" /></a></div>
  </section>
  <section class="closing wrap"><p class="eyebrow">{t('A PLACE FOR WHAT YOU WANT TO KEEP', 'UN LUGAR PARA LO QUE NO QUIERES PERDER')}</p><h2>{t('Open Mantis.', 'Abre Mantis.')}<br /><em>{t('The rest can wait.', 'El resto puede esperar.')}</em></h2><a class="button primary" href={site.download}><Icon name="download" />{t('Download Mantis', 'Descargar Mantis')} <span aria-hidden="true">↗</span></a><p>macOS 15+ · Apple Silicon · {t('MIT license', 'Licencia MIT')}</p><div class="release-notice">{t('Experimental build with local signing, not notarized by Apple.', 'Versión experimental con firma local, sin notarización de Apple.')}<br /><a href={`${localizedHref(language, 'docs')}#instalacion`}>{t('Read how to install and authorize Mantis', 'Lee cómo instalar y autorizar la app')}</a> {t('before your first recording.', 'antes de tu primera grabación.')}</div></section>
</SiteLayout>
