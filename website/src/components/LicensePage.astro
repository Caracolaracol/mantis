---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site, href, type Language } from '../lib/site';
import license from '../../../LICENSE?raw';
const { language = 'en' } = Astro.props as { language?: Language };
const t = (en: string, es: string) => language === 'es' ? es : en;
---
<SiteLayout language={language} title={t('License and credits — Mantis', 'Licencia y créditos — Mantis')} description={t('Mantis is open source under the MIT license. Read the full license and credits.', 'Mantis es código abierto bajo licencia MIT. Lee la licencia completa y los créditos.')} section="license">
  <div class="page-heading wrap"><p class="eyebrow">{t('CODE IS FOR SHARING, TOO', 'EL CÓDIGO TAMBIÉN ES PARA COMPARTIR')}</p><h1>{t('Open.', 'Abierto.')}<br /><em>{t('By choice.', 'Por elección.')}</em></h1><p>{t('Use, study, modify, and share Mantis. Licensed under MIT.', 'Usa, estudia, modifica y comparte Mantis. La licencia es MIT.')}</p></div>
  <article class="license-content wrap prose"><section><h2>{t('What you can do.', 'Lo que puedes hacer.')}</h2><p>{t('Mantis’s own code may be used, copied, modified, and redistributed, including commercially, as long as the copyright notice and license are preserved. It is provided without warranties. The text below is the full license, not a legal summary.', 'El código propio de Mantis puede usarse, copiarse, modificarse y redistribuirse, incluso comercialmente, conservando el aviso de autoría y la licencia. Se entrega sin garantías. El siguiente texto es la licencia completa, no un resumen legal.')}</p><pre class="license-text"><code>{license}</code></pre><a href={`${site.repo}/blob/main/LICENSE`}>{t('View LICENSE on GitHub', 'Ver LICENSE en GitHub')} ↗</a></section><section><h2>{t('Nothing is built alone.', 'No se construye en solitario.')}</h2><p>{t('Mantis uses', 'Mantis utiliza')} <a href="https://github.com/handy-computer/transcribe.cpp">transcribe.cpp</a>, {t('from the', 'del proyecto')} <a href="https://github.com/handy-computer">handy-computer</a> {t('project, for local transcription. Thanks to its authors and the ggml, Silero VAD, and miniz communities.', 'para la transcripción local. Gracias a sus autores y a las comunidades de ggml, Silero VAD y miniz.')}</p><p>{t('Third-party notices and licenses are preserved in', 'Los avisos y licencias de terceros se conservan en')} <a href={`${site.repo}/tree/main/Resources/ThirdParty`}>Resources/ThirdParty</a>. {t('Models keep their own licenses and are not bundled with the installer.', 'Los modelos mantienen sus propias licencias y no vienen incluidos en el instalador.')}</p><p>{t('Mantis is independent. It does not require Handy to be installed or imply affiliation or endorsement by Handy.', 'Mantis es independiente. No requiere Handy instalado ni implica afiliación o respaldo por parte de Handy.')}</p></section><section class="author-card"><img src={href('images/caracol.png')} width="72" height="57" alt={t('Snail, Agustín Rojas’s personal mark', 'Caracol, marca personal de Agustín Rojas')} /><div><p class="eyebrow">{t('BEHIND MANTIS', 'DETRÁS DE MANTIS')}</p><h2>Agustín Rojas</h2><a href={site.portfolio} target="_blank" rel="noopener noreferrer">{t('Take a look at my other projects', 'Pasa a ver mis otros proyectos')} ↗</a></div></section></article>
</SiteLayout>
